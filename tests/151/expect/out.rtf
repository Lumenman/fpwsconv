\pard\plain\kerning1\ql\li0\ri0\sl-240\slmult0\tx720\tx4752{\f0\fs24 \cf1 {\v Tuesday, October 30, 2018, from RABI: SCIENTIST AND CITIZEN\line}}\par
\pard\plain\kerning1\ql\li0\ri0\sl-240\slmult0\tx720\tx4752{\f0\fs24 \cf1 }\par
\pard\plain\kerning1\ql\li0\ri0\sl-240\slmult0\tx720\tx4752{\f0\fs24 \cf1 }\par

\pard\plain\kerning1\ql\li0\ri0\tx2002{\f1\fs44 \cf4 \b \f3\fs24 \cf1 \b0 This manual describes a Printer Description File for WordStar for DOS 6.0 and 7.0 that gives easy access to several features of HP LaserJet printers:}\par
\pard\plain\kerning1\ql\li0\ri0\tx2002{\f3\fs24 \cf1 }\par
\pard\plain\kerning1\ql\li720\ri0\tx1008{\f3\fs24 \cf1 \u8226?\tab proper quotation marks}\par
\pard\plain\kerning1\ql\li720\ri0\tx1008{\f3\fs24 \cf1 \u8226?\tab special symbols (em dash, en dash, ellipsis points, copyright symbol)}\par
\pard\plain\kerning1\ql\li720\ri0\tx1008{\f3\fs24 \cf1 \u8226?\tab gray scaling}\par
\pard\plain\kerning1\ql\li720\ri0\tx1008{\f3\fs24 \cf1 \u8226?\tab HP graphics patterns}\par
\pard\plain\kerning1\ql\li720\ri0\tx1008{\f3\fs24 \cf1 \u8226?\tab printing white text on a black background}\par
\pard\plain\kerning1\ql\li720\ri0\tx1008{\f3\fs24 \cf1 \u8226?\tab kerning of lowercase letter pairs}\par
\pard\plain\kerning1\ql\li0\ri0\tx1008{\f3\fs24 \cf1 }\par

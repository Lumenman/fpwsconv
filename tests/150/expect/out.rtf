\pard\plain\kerning1\ql\li2160\ri0\fi-2160\sl-240\slmult0\tx720\tx2160{\f0\fs24 WS.MNU\tab Compiled, ready-to-use version of MICKEE}\par
\pard\plain\kerning1\ql\li2160\ri0\fi-2160\sl-240\slmult0\tx720\tx2160{\f0\fs24 WS.DEF\tab Source code for MICKEE (\i replaces the file of the same name that comes with WordStar\i0 )}\par
\pard\plain\kerning1\ql\li0\ri0\fi-144\sl-240\slmult0\tx720\tx2160{\f0\fs24 }\par
